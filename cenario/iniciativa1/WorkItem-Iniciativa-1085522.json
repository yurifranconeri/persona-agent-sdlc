    "Custom.DescRiscosPremissas": "\u003Cdiv\u003En/a \u003C/div\u003E",
    "Custom.3700eda5-a109-4ece-890d-3d8be90ab486": "\u003Cdiv\u003EMelhoria na Jornada do Cliente \u003C/div\u003E",
    "Custom.ProblemaContextoOportunidade": "\u003Cdiv\u003E\u003Cspan\u003EAtualmente os clientes TIM não conseguem resetar a senha diretamente pela página da companhia aérea, é exibido uma mensagem (orientativa) para realizar o procedimento através do MEU TIM, o que traz uma quebra de jornada e diversas complicações.\u003Cbr\u003E\u003C/span\u003E\u003Cdiv\u003E\u003Cbr\u003E \u003C/div\u003E \u003C/div\u003E",
    "Custom.SumarioExecutivo": "\u003Cdiv\u003E\u003Cspan style=\"display:inline !important;\"\u003EDirecionar o cliente para a página de reset de senha, sem precisar acessar o APP Meu TIM, para melhorar a experiência do cliente\u003C/span\u003E\u003Cbr\u003E \u003C/div\u003E\u003Cdiv\u003E \u003C/div\u003E",
    "Custom.ObjetivoIniciativa": "\u003Cdiv\u003E\u003Cdiv style=\"box-sizing:border-box;\"\u003EAlterar a jornada atual do cliente fazendo que a mensagem o direcione para a página de reset \u003Cspan\u003E&nbsp;integrada ao sistema da Intelsat,&nbsp;\u003C/span\u003Esem precisar acessar o APP Meu TIM.&nbsp; \u003C/div\u003E\u003Cspan\u003E\u003C/span\u003E\u003Cbr\u003E\u003Cbr\u003E \u003C/div\u003E",
